# Store text with LF line endings, whatever editor or shell wrote it, so a
# Windows checkout cannot turn a one-line change into a whole-file rewrite.
* text=auto eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh   text eol=lf
*.svg  text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.png  binary
*.jpg  binary
*.gif  binary
*.pdf  binary
